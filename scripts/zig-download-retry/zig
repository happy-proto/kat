#!/usr/bin/env bash
set -euo pipefail

real_zig=${KAT_REAL_ZIG:?missing KAT_REAL_ZIG; use scripts/with-zig-download-retry.sh}
if [[ "${1:-}" != build ]]; then
  exec "$real_zig" "$@"
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT
delay=2
for attempt in 1 2 3 4; do
  status=0
  "$real_zig" "$@" 2> "$log" || status=$?
  cat "$log" >&2
  if [[ "$status" -eq 0 ]]; then
    exit 0
  fi

  # Match package-download diagnostics only, never arbitrary compiler errors.
  if [[ "$attempt" -eq 4 ]] || ! grep -Eq \
    'error: unable to (connect to server|download file): (NameServerFailure|TemporaryNameServerFailure|ConnectionTimedOut|ConnectionRefused|ConnectionResetByPeer|NetworkUnreachable|ConnectionAborted)$|build\.zig\.zon:[0-9]+:[0-9]+: error: invalid HTTP response: HttpConnectionClosing$' "$log"; then
    exit "$status"
  fi
  printf 'Zig dependency download failed (attempt %s/4); retrying in %ss\n' "$attempt" "$delay" >&2
  sleep "$delay"
  delay=$((delay * 2))
done
