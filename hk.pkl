amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

steps {
  ["merge-conflict"] {
    types = List("text")
    check = "hk util check-merge-conflict {{files}}"
  }
  ["private-key"] {
    types = List("text")
    check = "hk util detect-private-key {{files}}"
  }
  ["config-syntax"] {
    glob = List("**/*.toml", "**/*.yaml", "**/*.yml")
    check = "uv run --script scripts/check-config.py check {{files}}"
  }
  ["actions-lock"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", ".github/workflows/actions.lock", "**/action.yml", "**/action.yaml")
    check = "gh actions-lock --verify-local"
  }
  ["script-lint"] {
    glob = "scripts/*.py"
    check = "uvx ruff check {{files}}"
  }
  ["fmt"] { check = "cargo fmt --check" }
  ["release-notes"] {
    glob = List("scripts/release-binary-sizes.py", "scripts/publish-latest.sh", "scripts/tests/publish-latest.sh")
    check = "uv run --script scripts/release-binary-sizes.py self-test && bash scripts/tests/publish-latest.sh"
  }
  ["clippy"] {
    depends = "fmt"
    check = "cargo clippy --workspace --locked --all-targets -- -D warnings"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "git"
  }
  ["fix"] { enabled = false }
}
